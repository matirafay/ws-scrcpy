{
  "name": "scrcpy-sms-agent",
  "version": "1.3.0",
  "description": "Desktop agent that reads FortiToken codes from a scrcpy/ADB phone and posts them to HealthForce.",
  "main": "src/main.js",
  "bin": {
    "scrcpy-sms-mcp": "src/mcp-server.js"
  },
  "scripts": {
    "start": "electron .",
    "start:ui": "electron . --ui",
    "watch": "node src/watch/index.js",
    "cli": "node src/cli.js",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "electron": "35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.2chealth.scrcpy-sms-agent",
    "productName": "Scrcpy SMS Agent",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "scripts/**/*",
      "config.example.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/platform-tools",
        "to": "platform-tools"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Scrcpy SMS Agent",
      "uninstallDisplayName": "Scrcpy SMS Agent"
    }
  },
  "allowScripts": {
    "electron@35.7.5": true
  }
}
